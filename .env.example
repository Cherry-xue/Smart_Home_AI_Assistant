# ============================================================
# 智能家居 AI 助手平台 · 环境变量模板
# 复制为 .env 并填入真实值；本文件只放占位符，可安全提交
# ============================================================

# ---------------- 运行环境 ----------------
APP_ENV=development
# mock / mqtt / csv / real_gateway
DATA_MODE=mqtt

# ---------------- 大模型（阿里云百炼 DashScope）----------------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_NAME=qwen3.7-plus
EMBEDDING_MODEL_NAME=qwen3.7-text-embedding
# 注意：百炼实际模型 ID 是 qwen3.7-text-rerank，rerank 不走 OpenAI 兼容协议
RERANK_MODEL_NAME=qwen3.7-text-rerank
TAVILY_API_KEY=tvly-dev-xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------- MySQL ----------------
MYSQL_HOST=192.168.159.100
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=换成你的密码
MYSQL_DB=smart_home
MYSQL_DB_CHECKPOINT=smart_home_checkpoint

DATABASE_URL=mysql+pymysql://root:换成你的密码@192.168.159.100:3306/smart_home?charset=utf8mb4
CHECKPOINT_DATABASE_URL=mysql+pymysql://root:换成你的密码@192.168.159.100:3306/smart_home_checkpoint?charset=utf8mb4

# ---------------- MQTT ----------------
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------------- 安全边界 ----------------
HIGH_RISK_AUTO_EXEC=false
QUIET_HOURS_DEFAULT=22:00-07:00
